{
  "name": "studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "savetax-lab 2부 웹 검토 화면(에이전트 답안지를 보고 사람이 판정한다)",
  "scripts": {
    "gen:types": "node scripts/gen-types.mjs",
