{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savetax-lab.local/schema/judgment.schema.json",
  "title": "사람 판정 v1",
  "description": "웹 검토 화면에서 사람이 사건 하나에 내린 판정. <실행 디렉터리>/judgments/<case_id>.json. 채점기가 읽어 에이전트와의 일치와 완화 기준 기록(채점 명세 6절)을 만든다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "verdict", "label", "rows", "note", "reviewer", "reviewed_at"],
  "properties": {
    "schema_version": { "const": "judgment/v1" },
    "case_id": { "type": "string", "minLength": 1 },
    "verdict": {
      "enum": ["approve", "reject", "edit"],
      "description": "approve: 에이전트 결론을 승인 / reject: 결론을 반려(지적하지 않음) / edit: 라벨을 고쳐 다시 계산"
    },
    "label": {
      "oneOf": [{ "type": "null" }, { "enum": ["same_model", "equivalent", "different", "insufficient"] }],
      "description": "사람이 본 라벨(edit일 때 필수, 아니면 선택)"
    },
    "rows": {
      "type": "object",
      "description": "펼친 줄 등에 대한 줄 단위 판정(속성 → agree / disagree)",
      "additionalProperties": { "enum": ["agree", "disagree"] }
    },
    "note": { "type": "string", "maxLength": 2000 },
    "reviewer": { "type": "string", "maxLength": 100 },
    "reviewed_at": { "type": "string" }
  }
}
