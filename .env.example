# 복사해서 .env로 저장 (커밋 금지). 토큰은 '내 경기'에서 발급, 전체가 savetax_ 로 시작.
SAVETAX_TOKEN=
# Claude API (AI 에이전트 단계)
ANTHROPIC_API_KEY=
# 경로·한도 (기본값)
SAVETAX_DATA_DIR=./data
SAVETAX_DATA_RPS=0.9          # 데이터 API 시간 버킷(3,600/h)보다 약간 낮게
SAVETAX_SEARCH_RPS=1.8        # 검색 버킷(120/min)보다 약간 낮게
SAVETAX_CONTEST_RPS=1.0       # 대회 API 한도 미공개 → 보수적으로
SAVETAX_RETAIL_RPS=0.5        # 시중 사이트 도메인별
SAVETAX_USER_AGENT=Mozilla/5.0 (savetax-lab)
