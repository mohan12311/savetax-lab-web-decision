    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "json-schema-to-typescript": "15.0.3",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
